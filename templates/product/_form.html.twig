{{ form_start(form) }}
    {{ form_row(form.nama) }}
	{{ form_row(form.harga, {'attr': {'data-type': 'rupiah'}}) }}
	{{ form_row(form.tanggal) }}
	{{ form_row(form.tahun, {'attr': {'data-type': 'year'}}) }}
	{{ form_row(form.category) }}
	{{ form_row(form.image) }}
	<div class="row mb-2">
        {% if (button_label != 'Update') %}
            <div class="col-md-2" id="divimage_path">
                <img src="{{ asset('img/image.jpg') }}" alt="" class="img img-thumbnail img-preview " id="img-preview-path" style="width: 160px; height: 160px;">
            </div>
        {% endif %}

        {% if (button_label == 'Update') %}
            {% if product.image == null %}
                <div class="col-md-2" id="divcol_image">
                    <img src="{{ asset('images/img.png') }}" alt="" class="img img-thumbnail img-preview" id="img-preview-image" style="width: 160px; height: 160px;">
                </div>
            {% else %}
                <div class="col-md-2" id="divcol_image">
                    <img src="{{ asset(image_directory ~ product.image) }}" alt="" class="img img-thumbnail img-preview" id="img-preview-image" style="width: 160px; height: 160px;">
                </div>
            {% endif %}
        {% endif %}
    </div>
    <hr>
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}

{% block javascripts %}
    <script>
        // You can add custom JavaScript here if needed
        $(document).ready(function () {
            $("#product_image").change(function(e) {
                file_select(e, 'image');
            });
        });
    </script>
{% endblock %}