{% extends 'dashboard.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
<div class="content">
    <div class="container-fluid">
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
            <div class="flex-grow-1">
                <h4 class="fs-18 fw-semibold m-0">Product</h4>
            </div>

            <div class="text-end">
                <ol class="breadcrumb m-0 py-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_product_index') }}">Product</a></li>
                    <li class="breadcrumb-item active">Show</li>
                </ol>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    {{ include('product/_detail.html.twig') }}
                    <div class="d-flex justify-content mt-3 gap-1">
                        {% if has_permission('/product/update') %}
                        <a href="{{ path('app_product_edit', { 'id' : product.id}) }}" class="btn btn-info text-white"><i class="fa fa-edit"></i> edit</a>
                        {% endif %}
                        {% if has_permission('/product/delete') %}
                        <form method="post" id="formdelete" action="{{ path('app_product_delete', {'id': product.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                            <button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button>
                        </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
<script>
    $('#formdelete').submit(function (e) { 
        e.preventDefault();
        Swal.fire({
            title: "Apa Anda Yakin ?",
            text: "Mengahapus Data Ini !",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "YA, Hapus !",
            cancelButtonText: "Batal",
            }).then((result) => {
            if (result.isConfirmed) {
                e.target.submit();
            }
        });
    });
</script>
{% endblock %}