<table class="table table-bordered table-striped">
    <tbody>
                        
        <tr>
            <th style="width: 25%;">Nama Product</th>
            <td style="width: 75%;">{{ product.nama }}</td>
        </tr>
                        
        <tr>
            <th style="width: 25%;">Harga</th>
            <td style="width: 75%;">{{ product.harga|rupiah }}</td>
        </tr>
                        
        <tr>
            <th style="width: 25%;">Tanggal</th>
            <td style="width: 75%;">{{ product.tanggal ? product.tanggal|date('d-m-Y') : "" }}</td>
        </tr>
                                
        <tr>
            <th style="width: 25%;">Tahun</th>
            <td style="width: 75%;">{{ product.tahun }}</td>
        </tr>
                        
    </tbody>
</table>