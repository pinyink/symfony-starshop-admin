<table class="table table-bordered table-striped">
    <tbody>
                                
        <tr>
            <th style="width: 25%;">Nama Product</th>
            <td style="width: 75%;">{{ product.nama }}</td>
        </tr>
                                
        <tr>
            <th style="width: 25%;">Harga</th>
            <td style="width: 75%;">{{ product.harga|rupiah }}</td>
        </tr>
                                
        <tr>
            <th style="width: 25%;">Tanggal</th>
            <td style="width: 75%;">{{ product.tanggal ? product.tanggal|date('d-m-Y') : "" }}</td>
        </tr>
                                        
        <tr>
            <th style="width: 25%;">Tahun</th>
            <td style="width: 75%;">{{ product.tahun }}</td>
        </tr>
                                                
        <tr>
            <th style="width: 25%;">Categories</th>
            <td style="width: 75%;">{{ product.category.name ?? '' }}</td>
        </tr>
                                
        <tr>
            <th style="width: 25%;">Image</th>
            <td style="width: 75%;">
                <img src="{{ product.image == null ? asset('images/img.png') : asset(image_directory ~ product.image) }}"
                    alt="" class="img img-thumbnail img-preview" id="img-preview-path"
                    style="width: 160px; height: 160px;">
            </td>
        </tr>
                        
    </tbody>
</table>
