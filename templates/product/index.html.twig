{% extends 'dashboard.html.twig' %}

{% block title %} Product {% endblock %}

{% block body %}
<div class="content">
    <div class="container-fluid">
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
            <div class="flex-grow-1">
                <h4 class="fs-18 fw-semibold m-0">Product</h4>
            </div>

            <div class="text-end">
                <ol class="breadcrumb m-0 py-0">
                    <li class="breadcrumb-item active">
                        <a href="{{ path('app_product_index') }}">Product</a>
                    </li>
                </ol>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h5 class="card-title mb-0">Data Product</h5>

                        <div class="ms-auto"> 
                            {% if has_permission('/product/add') %}
                                <a href="{{ path('app_product_new') }}" class="btn btn-sm btn-primary"><i class="fa fa-plus"></i> Tambah</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="table">Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(function() {
    $('#table').initDataTables({{ datatable_settings(datatable) }}, 
        {
            searching: true,
        }
    );
});
</script>
{% endblock %}