{% extends 'dashboard.html.twig' %}

{% block title %} Role {% endblock %}

{% block body %}
<div class="content">
    <div class="container-fluid">
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
            <div class="flex-grow-1">
                <h4 class="fs-18 fw-semibold m-0">Admin</h4>
            </div>

            <div class="text-end">
                <ol class="breadcrumb m-0 py-0">
                    <li class="breadcrumb-item active">
                        <a href="{{ path('app_role_index') }}">Roles</a>
                    </li>
                </ol>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h5 class="card-title mb-0">Data Product</h5>

                        <div class="ms-auto"> 
                            <button class="btn btn-primary" onclick="tambah()">Tambah</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="table" class="table table-bordered table-striped w-100">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th>##</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for role in roles %}
                                <tr>
                                    <td>{{ role.id }}</td>
                                    <td>{{ role.code }}</td>
                                    <td>{{ role.description }}</td>
                                    <td>
                                        <button class="btn btn-sm btn-info" onclick="edit_data({{ role.id }}, '{{ role.code }}', '{{ role.description}}')">Edit</button>
                                        <button class="btn btn-sm btn-danger" onclick="delete_data({{ role.id }})">Delete</button>
                                        <a href="{{ path('app_role_permission', {'id': role.id}) }}" class="btn btn-sm btn-primary">Permission</a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6">no records found</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="form" method="post" action="{{ path('app_role_save') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('add_edit') }}">
            <input type="hidden" name="method" value="">
            <input type="hidden" name="id" value="">

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div class="form-group mb-3">
                        <label for="code">Code</label>
                        <input type="text" class="form-control" name="code">
                    </div>
                    <div class="form-group mb-3">
                        <label for="desc">Description</label>
                        <input type="text" class="form-control" name="desc">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" id="button-save" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script>
        function tambah() {
            $('#exampleModalLabel').html('Tambah Role');
            $('#form')[0].reset();
            $('input[name="method"]').val('tambah');
            $('#exampleModal').modal('show');
        }

        function edit_data(id, code, desc) {
            $('#exampleModalLabel').html('Edit Role');
            $('input[name="method"]').val('edit');
            $('input[name="id"]').val(id);
            $('input[name="code"]').val(code);
            $('input[name="desc"]').val(desc);
            $('#exampleModal').modal('show');
        }

        function delete_data(id) {
            Swal.fire({
                title: "Delete ?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: "#e81729",
                confirmButtonText: "Delete",
                denyButtonText: `Don't Delete`
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "delete",
                        url: "{{ path('app_role_delete') }}",
                        data: {'_token' : "{{ csrf_token('hapus') }}", 'id' : id},
                        dataType: "json",
                        success: function (response) {
                            Swal.fire({
                                icon: "success",
                                title: response.message,
                                showConfirmButton: true,
                                timer: 1500
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.reload();
                                }
                            });
                        },
                        error: function(jqXHR) {
                            console.log(jqXHR.responseText);
                        }
                    });
                }
            });
        }

    </script>
{% endblock %}