{% extends 'base.html.twig' %}

{% block title %}Permissions index{% endblock %}

{% block stylesheets %}
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/css/dataTables.bootstrap.min.css" integrity="sha512-BMbq2It2D3J17/C7aRklzOODG1IQ3+MHw3ifzBHMBwGO/0yUqYmsStgBjI0z5EYlaDEFnvYV7gNYdD3vFLRKsA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!--end::Vendor Stylesheets-->
    
    <link rel=”stylesheet” href=”https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css” />
{% endblock %}

{% block body %}
    <div class="container">
        <div class="mt-5 mb-5 d-flex align-items-center justify-content-between">
            <h1>Permission Role {{ role.code ~ " ~ " ~ role.description }}</h1>
            <div class="d-flex">
                <a href="{{ path('app_role_index') }}" class="btn btn-secondary">Kembali</a>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}
        
        <div class="table-responsive bg-white rounded-2">
            <table id="tbl_list" class="table table-row-dashed table-row-gray-200 align-middle gs-0 gy-4 table-bordered">
                <thead>
                    <tr>
                        <th style="width: 5%;">Id</th>
                        <th style="width: 20%;">Code</th>
                        <th style="width: 30%;">Description</th>
                        <th style="width: 45%;">Sub Menus</th>
                    </tr>
                </thead>
                <tbody>
                {% for permission in permissions %}
                    <tr>
                        <td>{{ permission.id }}</td>
                        <td>{{ permission.code }}</td>
                        <td>{{ permission.description }}</td>
                        <td>
                            <table>
                                {% for child in permission.child %}
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="checkbox" name="permission[]" value="{{ child.id }}" {% if child.checked is defined %} {{ child.checked }} {% endif %} >
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">{{ child.code ~ " ~ " ~ child.description }}</span>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr class="text-muted">
                                        <td>
                                            no sub menus
                                        </td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <!-- Optional JavaScript; choose one of the two! -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>

    <!-- Option 1: Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous">
    </script>

    <!-- Option 2: Separate Popper and Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"
        integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js"
        integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous">
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.5/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.1.5/js/dataTables.bootstrap5.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        
        $( ".checkbox" ).on( "click", function() {
            var val = $(this).val();
            if ($( this ).is(":checked")) {
                console.log("checked "+val);
                add_permission(val);
            } else {
                console.log("unchecked " + val);
                remove_permission(val);
            }
        });

        function add_permission(id) {
            $.ajax({
                type: "post",
                url: "{{ path('app_role_add_permission', {'id': role.id}) }}",
                data: { permission_id: id, role_id: {{ role.id }}, _token: '{{ csrf_token('add_permission') }}' },
                dataType: "JSON",
                success: function (response) {
                    Swal.fire({
                        icon: "success",
                        title: response.message,
                        showConfirmButton: true,
                        timer: 1500
                    });
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
        }

        function remove_permission(id) {
            $.ajax({
                type: "post",
                url: "{{ path('app_role_remove_permission', {'id': role.id}) }}",
                data: { permission_id: id, role_id: {{ role.id }}, _token: '{{ csrf_token('remove_permission') }}' },
                dataType: "JSON",
                success: function (response) {
                    Swal.fire({
                        icon: "success",
                        title: response.message,
                        showConfirmButton: true,
                        timer: 1500
                    });
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
        }
    </script>
{% endblock %}