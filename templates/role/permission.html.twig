{% extends 'dashboard.html.twig' %}

{% block title %} Permissions Roles {% endblock %}

{% block body %}
<div class="content">
    <div class="container-fluid">
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
            <div class="flex-grow-1">
                <h4 class="fs-18 fw-semibold m-0">Permissions Roles for {{ role.code }}</h4>
            </div>

            <div class="text-end">
                <ol class="breadcrumb m-0 py-0">
                    <li class="breadcrumb-item active">
                        <a href="{{ path('app_role_index') }}">Roles</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="javascript:;">Permissions</a>
                    </li>
                </ol>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h5 class="card-title mb-0"></h5>

                        <div class="ms-auto"> 
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="table" class="table table-bordered table-striped w-100">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">Id</th>
                                    <th style="width: 20%;">Code</th>
                                    <th style="width: 30%;">Description</th>
                                    <th style="width: 45%;">Sub Menus</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for permission in permissions %}
                                <tr>
                                    <td>{{ permission.id }}</td>
                                    <td>{{ permission.code }}</td>
                                    <td>{{ permission.description }}</td>
                                    <td>
                                        <table>
                                            {% for child in permission.child %}
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" class="checkbox" name="permission[]" value="{{ child.id }}" {% if child.checked is defined %} {{ child.checked }} {% endif %} >
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-primary">{{ child.code ~ " ~ " ~ child.description }}</span>
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr class="text-muted">
                                                    <td>
                                                        no sub menus
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </table>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6">no records found</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script>
        $(document).ready(function () {
            $( ".checkbox" ).on( "click", function() {
                var val = $(this).val();
                if ($( this ).is(":checked")) {
                    console.log("checked "+val);
                    add_permission(val);
                } else {
                    console.log("unchecked " + val);
                    remove_permission(val);
                }
            });
        });

        function add_permission(id) {
            $.ajax({
                type: "post",
                url: "{{ path('app_role_add_permission', {'id': role.id}) }}",
                data: { permission_id: id, role_id: {{ role.id }}, _token: '{{ csrf_token('add_permission') }}' },
                dataType: "JSON",
                success: function (response) {
                    Swal.fire({
                        icon: "success",
                        title: response.message,
                        showConfirmButton: true,
                        timer: 1500
                    });
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
        }

        function remove_permission(id) {
            $.ajax({
                type: "post",
                url: "{{ path('app_role_remove_permission', {'id': role.id}) }}",
                data: { permission_id: id, role_id: {{ role.id }}, _token: '{{ csrf_token('remove_permission') }}' },
                dataType: "JSON",
                success: function (response) {
                    Swal.fire({
                        icon: "success",
                        title: response.message,
                        showConfirmButton: true,
                        timer: 1500
                    });
                },
                error: function (jqXHR) {
                    console.log(jqXHR.responseText);
                }
            });
        }
    </script>
{% endblock %}