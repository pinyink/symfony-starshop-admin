<!DOCTYPE html>
<html lang="{{ setting('language', 'id') }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="{{ setting('app_description', 'Application description') }}">
        <title>{% block title %}{{ setting('app_name', 'My Application') }}{% endblock %}</title>
        {% if setting('app_favicon') %}
            <link rel="icon" href="{{ asset(setting('app_favicon')) }}">
        {% else %}
            <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% endif %}
        {% block stylesheets %}
        {% endblock %}

    </head>
    <body>
        {% block body %}{% endblock %}
        {% block javascripts %}
        {% endblock %}
    </body>
</html>
