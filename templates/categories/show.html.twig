{% extends 'dashboard.html.twig' %}

{% block title %} Categories Show {% endblock %}

{% block body %}
<div class="content">
    <div class="container-fluid">
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
            <div class="flex-grow-1">
                <h4 class="fs-18 fw-semibold m-0">Categories</h4>
            </div>

            <div class="text-end">
                <ol class="breadcrumb m-0 py-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_categories_index') }}">Categories</a></li>
                    <li class="breadcrumb-item active">Show</li>
                </ol>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h5 class="card-title mb-0">Detail Categories</h5>

                        <div class="ms-auto"> 
                            {% if has_permission('/categories/add') %}
                                <a href="{{ path('app_categories_new') }}" class="btn btn-sm btn-primary"><i class="fa fa-plus"></i> Tambah</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    {{ include('categories/_detail.html.twig') }}
                    <div class="d-flex justify-content mt-3 gap-1">
                        {% if has_permission('/categories/update') %}
                        <a href="{{ path('app_categories_edit', { 'id' : categories.id}) }}" class="btn btn-info text-white"><i class="fa fa-edit"></i> edit</a>
                        {% endif %}
                        {% if has_permission('/categories/delete') %}
                        <form method="post" id="formdelete" action="{{ path('app_categories_delete', {'id': categories.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categories.id) }}">
                            <button class="btn btn-danger"><i class="fa fa-trash"></i> Delete</button>
                        </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


{% block javascripts %}
<script>
    $('#formdelete').submit(function (e) { 
        e.preventDefault();
        Swal.fire({
            title: "Apa Anda Yakin ?",
            text: "Mengahapus Data Ini !",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "YA, Hapus !",
            cancelButtonText: "Batal",
            }).then((result) => {
            if (result.isConfirmed) {
                e.target.submit();
            }
        });
    });
</script>
{% endblock %}